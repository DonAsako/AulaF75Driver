{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AULA F75",
  "identifier": "io.github.donasako.aulaf75",
  "version": "0.1.0",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AULA F75",
        "width": 1180,
        "height": 880,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
